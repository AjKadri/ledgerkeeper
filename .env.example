# Tatum (dashboard.tatum.io)
TATUM_API_KEY=
# Walrus Memory (memory.walrus.xyz, mainnet). MemWalAccount object id, not a wallet address.
MEMWAL_ACCOUNT_ID=
MEMWAL_SERVER_URL=https://relayer.memory.walrus.xyz
# Two delegate PRIVATE keys registered on that account
MEMWAL_KEY_APP_A=
MEMWAL_KEY_APP_B=
# Set to false to run read-only
MEMORY_WRITES_ENABLED=true
